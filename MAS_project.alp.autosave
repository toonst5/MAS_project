					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[

IV_energy += 80;

IV_foodTarget.setSize(
    IV_foodTarget.getWidth() - 2,
    IV_foodTarget.getHeight() - 2
);

IV_foodTarget.setPos(
    IV_foodTarget.getX() + 1,
    IV_foodTarget.getY() + 1
);
]]></EntryAction>
