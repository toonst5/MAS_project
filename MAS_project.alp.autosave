					<Action><![CDATA[

for (ShapeRectangle n : this.food_Nodes) {
	if(n.getWidth()<200)
	{
		n.setSize(
		    n.getWidth() + 10,
		    n.getHeight() + 10
		);
		
		n.setPos(
		    n.getX() - 5,
		    n.getY() - 5
		);
	}
}]]></Action>
