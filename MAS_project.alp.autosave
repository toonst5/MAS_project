		<ActiveObjectClass>
			<Id>1779214914767</Id>
			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[shipClass.setVisible(false);

double shipW = 120;
double shipH = 100;

double shipX = oceanNode.getX() + shipW+ uniform(0, oceanNode.getWidth() -  2* shipW);
double shipY = oceanNode.getY() + shipH+ uniform(0, oceanNode.getHeight() - 2* shipH);

//Point p = oceanNode.randomPointInside();
shipClass.setPos(shipX, shipY);




/*for (A_Fish f : fish) {
	double Fx = oceanNode.getX() + 8 
             + uniform(0, oceanNode.getWidth() - 2 * 8);
    double Fy = oceanNode.getY() + 5 
             + uniform(0, oceanNode.getHeight() - 2 * 5);
             f.setXY(Fx, Fy);
	}
	

for (A_Predator pre : predator) {
	double Px = oceanNode.getX() + 12
             + uniform(0, oceanNode.getWidth() - 2 * 12);
    double Py = oceanNode.getY() + 8 
             + uniform(0, oceanNode.getHeight() - 2 * 8);
             pre.setXY(Px, Py);
	}
*/
ShipSinks.restart(uniform(1, 50));]]></StartupCode>
