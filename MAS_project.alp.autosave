			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[A_Fish]]></ReturnType>
					<Id>1779974932861</Id>
					<Name><![CDATA[nearestFish]]></Name>
					<X>20</X><Y>130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
A_Fish nearest = null;
if (main != null)
{
	double bestDist = Double.MAX_VALUE;
	
	for (A_Fish f : main.fishPopulation) {
	    if (f != this) {
	        double d = distanceTo(f);
	        if (d < bestDist) {
	            bestDist = d;
	            nearest = f;
	        }
	    }
	}
}
return nearest;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[A_Predator]]></ReturnType>
					<Id>1779981412507</Id>
					<Name><![CDATA[nearestPredator]]></Name>
					<X>20</X><Y>150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
A_Predator nearest = null;
if (main != null)
{
	double bestDist = Double.MAX_VALUE;
	
	for (A_Predator f : main.predatorPopulation) {
	    double d = distanceTo(f);
	    if (d < bestDist) {
	        bestDist = d;
	        nearest = f;
	    }
	}
}
return nearest;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ShapeRectangle]]></ReturnType>
					<Id>1779981415967</Id>
					<Name><![CDATA[nearestFood]]></Name>
					<X>20</X><Y>170</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
ShapeRectangle closestFood = null;
double minDist = Double.MAX_VALUE;

for (ShapeRectangle n : main.food_Nodes) {
    // only consider open food nodes
    if (n.getWidth() > 30) {//n.isOpen()
        double d = distanceTo(n.getCenter().x, n.getCenter().y);

        if (d < minDist) {
            minDist = d;
            closestFood = n;
        }
    }
}

return closestFood;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1780148179430</Id>
					<Name><![CDATA[countNeighbors]]></Name>
					<X>20</X><Y>190</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
int count = 0;

for (A_Fish f : main.fishPopulation) {
    if (f != this && distanceTo(f) < V_schoolingRange) {
        count++;
    }
}

return count;
]]></Body>
				</Function>
			</Functions>
