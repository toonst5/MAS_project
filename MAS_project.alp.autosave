				<StatechartElement Class="State" ParentState="ROOT_NODE">
					<Id>1779707963230</Id>
					<Name><![CDATA[move_to_fish]]></Name>
					<X>600</X><Y>290</Y>
					<Label><X>10</X><Y>10</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties Width="100" Height="30">
						<EntryAction><![CDATA[
double cx = 0;
double cy = 0;
int count = 0;

for (A_Fish f : main.fishPopulation) {
    if (f != this && distanceTo(f) < V_visionRange) {
        cx += f.getX();
        cy += f.getY();
        count++;
    }
}

if (count > 0) {
    cx /= count;
    cy /= count;
    moveTo(cx, cy);
}
]]></EntryAction>
						<FillColor>-10496</FillColor>
					</Properties>
				</StatechartElement>
