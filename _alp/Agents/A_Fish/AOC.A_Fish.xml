			<ShowLabel>true</ShowLabel>
			<Properties Width="135" Height="30">
				<EntryAction>
double cx = 0;
double cy = 0;
int count = 0;

for (A_Fish f : main.fishPopulation) {
    if (f != this &amp;&amp; distanceTo(f) &lt; V_visionRange) {
        cx += f.getX();
        cy += f.getY();
        count++;
    }
}

if (count &gt; 0) {
    cx /= count;
    cy /= count;
    moveTo(cx, cy);
    IV_energyDrain = 10;
}
</EntryAction>
