			<Properties Width="100" Height="30">
				<EntryAction>int n = 3;

double fx = this.getX();
double fy = this.getY();
double px = IV_nearestPredator.getX();
double py = IV_nearestPredator.getY();

Point bestPoint = null;
double bestDist = -1;

for (int i = 0; i &lt; n; i++) {
    Point candidate = getRandomPointInRange();

    double dx = candidate.getX() - px;
    double dy = candidate.getY() - py;
    double distFromPredator = Math.sqrt(dx * dx + dy * dy);

    if (distFromPredator &gt; bestDist) {
        bestDist  = distFromPredator;
        bestPoint = candidate;
    }
}
moveTo(bestPoint);</EntryAction>
				<FillColor>-10496</FillColor>
			</Properties>
