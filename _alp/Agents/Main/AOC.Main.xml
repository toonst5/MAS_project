	<StartupCode><![CDATA[ shipClass.setVisible(false);



exportFile.println(
	"time"
	+ "; "
	+ "fishPopulationSize"
	+ "; "
	+ "predatorPopulationSize"
);

//RectangularNode shipZone; // just declaration
shipZone = new RectangularNode();
double oceanWidth = oceanNode.getWidth();
double oceanHeight = oceanNode.getHeight();
double oceanX = oceanNode.getX();
double oceanY = oceanNode.getY();
double shipWidth = 400.0;
double shipHeight = 100.0;
double shipRotation = uniform(0, 360); // Full random rotation
double randomX = uniform(oceanX + shipWidth/2, oceanX + oceanWidth - shipWidth/2);
double randomY = uniform(oceanY + shipHeight/2, oceanY + oceanHeight - shipHeight/2);
shipZone.setPos(randomX, randomY, 0.0);
shipZone.setSize(shipWidth, shipHeight);
shipZone.setRotation(shipRotation);
shipZone.setFillColor(new Color(139, 90, 43, 180));  // brown, semi-transparent
shipZone.setLineColor(new Color(80, 50, 20, 255));    // darker brown border
shipZone.setLineWidth(2);
shipZone.setOwner(this); // ← alternative if no auto-generated add_ method
//add_shipZone(shipZone); // ← registers it with Main so it renders
shipClass.setPos(randomX, randomY, 0.0);
shipClass.setRotation(shipRotation);

// Create a level, add the node, then initialize
Level shipLevel = new Level(this, "shipLevel", SHAPE_DRAW_2D3D, 0);
shipLevel.add(shipZone);
shipLevel.initialize();

// Make it visible in the presentation
presentation.add(shipLevel);

//double nodeArea = oceanNode.getWidth() * oceanNode.getHeight();
//double nodeRate = 10.0 / nodeArea;
spawnRates.add(5.);
spawnNodes.add(oceanNode);
totalSpawnRate = spawnRates.stream().mapToDouble(Double::doubleValue).sum();


//shipwreck causes
double killRadius = 40;
double avoidRadius = 70;
double contamRadius = 80;

ShipSinks.restart(uniform(1, 30));

]]></StartupCode>
