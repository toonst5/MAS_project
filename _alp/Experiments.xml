	<CompareRunsExperiment ActiveObjectClassId="1779214914767">
		<Id>1780858052467</Id>
		<Name><![CDATA[CompareRuns]]></Name>
		<CommandLineArguments/>
		<MaximumMemory>512</MaximumMemory>
		<RandomNumberGenerationType>randomSeed</RandomNumberGenerationType>
		<CustomGeneratorCode>new Random()</CustomGeneratorCode>
		<AfterSimulationRunCode>parametersOfRuns.add( new Object[] { V_TypeOveride, V_MutationChance } );
int numberOfRuns = getEngine().getRunCount();
Color color = spectrumColor( (numberOfRuns * 4) % 21, 21 );
while ( chart0.getCount() &gt;= parametersOfRuns.size() ) {
	chart0.remove( chart0.getCount() - 1 );
}
chart0.addDataSet( root.dataset, "Run " + numberOfRuns, color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
while ( chart1.getCount() &gt;= parametersOfRuns.size() ) {
	chart1.remove( chart1.getCount() - 1 );
}
chart1.addDataSet( root.dataset1, "Run " + numberOfRuns, color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
while ( chart2.getCount() &gt;= parametersOfRuns.size() ) {
	chart2.remove( chart2.getCount() - 1 );
}
chart2.addDataSet( root.dataset2, "Run " + numberOfRuns, color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
while ( chart3.getCount() &gt;= parametersOfRuns.size() ) {
	chart3.remove( chart3.getCount() - 1 );
}
chart3.addDataSet( root.dataset3, "Run " + numberOfRuns, color, true, Chart.INTERPOLATION_LINEAR, 1, Chart.POINT_NONE );
</AfterSimulationRunCode>
